# Copy this file to .env and fill in actual values.
# Keep .env out of git.

NODE_ENV=development
PORT=3000

# Core app database (currently PostgreSQL-compatible for app persistence)
DATABASE_URL="postgresql://user:password@localhost:5432/silo"

# Auth
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# Frontend/backend URLs
FRONTEND_URL="http://localhost:5173"
API_URL="http://localhost:3000"
VITE_API_URL="http://localhost:3000"

# Integrations and encryption
INTEGRATION_ENCRYPTION_KEY="32-char-min-key"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# AI providers
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""