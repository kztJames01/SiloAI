# Copy this file to .env and fill in actual values.
# Keep .env out of git.

NODE_ENV=development
PORT=5000

# Monitoring (optional — protects /metrics in production)
# METRICS_TOKEN="your-metrics-bearer-token"

# Core app database (PostgreSQL / Supabase)
# Option A — full URL (quote it if password has # or @)
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require"
# Option B — raw password (no URL encoding needed); backend builds DATABASE_URL for you
# SUPABASE_PROJECT_REF="your-project-ref"
# SUPABASE_POOLER_HOST="aws-1-us-east-2.pooler.supabase.com"
# SUPABASE_DB_PASSWORD="your-database-password"

# Auth
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# Frontend/backend URLs
FRONTEND_URL="http://localhost:5173"
API_URL="http://localhost:5000"
VITE_API_URL="http://localhost:5000"
EXPO_PUBLIC_API_URL="http://localhost:5000"
# Deep link scheme the mobile app registers (app.json "scheme"). Used to bounce
# OAuth back into the app after the browser step.
MOBILE_APP_SCHEME="silomobile"

# Integrations and encryption
INTEGRATION_ENCRYPTION_KEY="32-char-min-key"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# AI providers
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""